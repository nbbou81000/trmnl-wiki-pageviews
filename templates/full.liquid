{% assign repo_base = "https://cdn.jsdelivr.net/gh/nbbou81000/trmnl-wiki-pageviews@main/docs" %}
{% assign chosen_lang = trmnl.plugin_settings.custom_fields_values.wiki_lang | default: "en" %}
{% assign display_mode = trmnl.plugin_settings.custom_fields_values.display_mode | default: "image" %}

<div class="layout layout--row portrait:layout--col gap--large">

  {% if display_mode == "image" %}
    {% for entry in data %}
      {% if entry.lang == chosen_lang and entry.has_thumbnail %}
        <div class="w--[200px] lg:w--[300px] portrait:w--base no-shrink">
          <img
            class="image image-dither image--cover h--[360px] lg:h--[520px] portrait:h--[280px]"
            src="{{ repo_base }}/images/{{ chosen_lang }}/latest.png"
          />
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}

  <div class="stretch-x">
    {% for entry in data %}
      {% if entry.lang == chosen_lang %}

        {% if display_mode == "image" %}

          <span class="label label--underline">{{ entry.date }} &mdash; {{ entry.lang | upcase }}.wikipedia</span>

          <div class="columns">
            <div class="column">
              {% for article in entry.articles %}
                <div class="item">
                  <div class="meta">
                    <span class="index">{{ article.rank }}</span>
                  </div>
                  <div class="content">
                    <span class="title title--small lg:title--base">{{ article.title }}</span>
                    <span class="description">{{ article.views_label }} vues</span>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

        {% else %}

          <div class="flex flex--row flex--center-y gap">
            <span class="label label--underline grow">{{ entry.date }} &mdash; {{ entry.lang | upcase }}.wikipedia</span>
            <span class="label label--small no-shrink w--[76px] text--right">vs veille</span>
            <span class="label label--small no-shrink w--[100px] text--center">7 jours</span>
          </div>

          <div class="flex flex--col gap--small">
            {% for article in entry.articles %}
              <div class="flex flex--row flex--center-y gap">
                <span class="index no-shrink">{{ article.rank }}</span>

                <div class="grow">
                  <span class="title title--small lg:title--base">{{ article.title }}</span>
                  <span class="description">{{ article.views_label }} vues</span>
                </div>

                <span class="label no-shrink w--[76px] text--right">{{ article.change_label }}</span>

                <svg class="no-shrink" width="100" height="24" viewBox="0 0 100 24">
                  {% for bar in article.sparkline_bars %}
                    <rect
                      x="{{ bar.x }}"
                      y="{{ bar.y }}"
                      width="{{ bar.w }}"
                      height="{{ bar.h }}"
                      fill="currentColor"
                    />
                  {% endfor %}
                </svg>
              </div>
            {% endfor %}
          </div>

        {% endif %}
      {% endif %}
    {% endfor %}
  </div>

</div>

<div class="title_bar">
  <span class="title">Top Wikipedia</span>
  <span class="instance">{{ chosen_lang | upcase }}</span>
</div>
